# ============================================================
# hosts.env — destinations SSH des VMs (copier en hosts.env).
# NON VERSIONNÉ : contient la topologie réelle du lab.
#
# DEPLOY_HOST_<vm> : destination SSH (user@ip, ou alias ~/.ssh/config),
#   ou la valeur spéciale "local" si ce dépôt est déjà sur la VM
#   (exécution directe de make, sans SSH ni rsync).
#
# ATTENTION : préférer les IP aux noms courts — les /etc/hosts de
# certaines VMs du lab sont périmés (ex. "lorion03vel" pointe parfois
# vers une autre instance).
# ============================================================

# Clé SSH : rien à faire — deploy.sh l'installe automatiquement au premier
# contact (ssh-copy-id, mot de passe demandé une seule fois par VM).
#
# Multi-utilisateurs : $USER@... fait déployer chacun sous SON compte. Les
# fichiers distants appartiennent au dernier déployeur ; ça fonctionne parce
# que (1) tous les déployeurs sont dans le groupe `ops`, (2) l'arbre
# distant est g+rwX avec dossiers setgid (fait une fois par VM), et
# (3) deploy.sh pousse en --chmod=Dg+rwxs,Fg+rw. Si un nouveau venu voit
# des "Permission denied" rsync, rejouer sur la VM :
#   chmod -R g+rwX /data/orion-lab-stack && find /data/orion-lab-stack -type d -exec chmod g+s {} +
#
# $USER = celui qui lance deploy.sh (le fichier est sourcé par bash) :
# chaque opérateur se connecte à SON compte sur la VM, et c'est SON mot
# de passe qui est demandé au premier contact — pas celui d'un autre.
# Le compte doit exister sur la VM avec le même nom d'utilisateur.
DEPLOY_HOST_lorion01vel=$USER@10.10.1.12
DEPLOY_HOST_lorion03vel=local

# Dossiers racine supplémentaires à pousser avec une VM (séparés par des
# espaces). La doc est incluse dans le compose de lorion03vel mais vit à la
# racine du dépôt.
EXTRA_SYNC_lorion03vel="orion-stack-documentation"

# Chemin du dépôt sur les VMs distantes. Par défaut (variable non définie) :
# autoCOREBIB/orion-lab-stack, chemin RELATIF résolu sous le home de
# l'utilisateur SSH — chacun déploie dans ~/autoCOREBIB/orion-lab-stack.
# Ne définir REMOTE_DIR que pour un emplacement absolu partagé (ex. /data/...).
#REMOTE_DIR=/data/orion-lab-stack

# lorion02vel : renseigner l'IP SSH de la VM avant le premier deploy
#DEPLOY_HOST_lorion02vel=$USER@<ip-vm>
