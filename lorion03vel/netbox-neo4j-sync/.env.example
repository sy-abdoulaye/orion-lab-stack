# ============================================================
# Configuration netbox-neo4j-sync — copier en .env et renseigner.
# ============================================================

# ── NetBox (API REST) ───────────────────────────────────────
# URL interne (réseau lorion03vel-network). Port interne = 8080.
NETBOX_API_URL=http://netbox:8080
# Token API à créer dans NetBox (Admin -> API Tokens), droits lecture DCIM.
# NETBOX_TOKEN -> mettre la valeur dans secrets/netbox_token (chmod 600), montée par compose (NETBOX_TOKEN_FILE)
# NetBox est en HTTP interne : pas de vérification TLS.
NETBOX_VERIFY_SSL=false

# ── Webhook (receiver) ──────────────────────────────────────
# Secret partagé avec le Webhook NetBox (signature HMAC-SHA512).
# WEBHOOK_SECRET -> secrets/webhook_secret (chmod 600)

# ── Neo4j ───────────────────────────────────────────────────
NEO4J_URI=bolt://lorion03vel-neo4j:7687
NEO4J_USER=neo4j
# = contenu de lorion03vel/neo4j/secrets/neo4j_admin_password
# NEO4J_PASSWORD -> secrets/neo4j_password (chmod 600)

# ── Reconciler ──────────────────────────────────────────────
# Intervalle entre deux cycles de synchronisation complète (secondes).
RECONCILE_INTERVAL_SECONDS=900

# ── Divers ──────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Build uniquement (proxy pour pip pendant docker build) ──
# Décommenter/renseigner si le build a besoin du proxy pour joindre PyPI.
# Ne sont PAS utilisés à l'exécution des conteneurs.
#BUILD_HTTP_PROXY=http://<https_proxy_addr>:<port>
#BUILD_HTTPS_PROXY=http://<https_proxy_addr>:<port>

# ── Image buildée ───────────────────────────────────────────
# Tag de l'image locale (orion/<service>:<tag>). Bump à chaque évolution :
# l'ancienne image reste disponible pour un rollback.
#IMAGE_TAG=0.1.0
