# ============================================================
# Configuration gobgp-neo4j-sync — copier en .env et renseigner.
# ============================================================

# ── ClickHouse (base gobgp, protocole natif port 9000) ──────
# ClickHouse tourne en conteneur sur CETTE VM (lorion03vel), sur le même
# réseau Docker lorion03vel-network : utiliser le nom du conteneur.
# NE PAS mettre l'IP de l'hôte (10.10.3.141) : le hairpin NAT est bloqué,
# la connexion échouerait depuis un conteneur de la même VM.
CLICKHOUSE_HOST=lorion03vel-clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=gobgp
CLICKHOUSE_USER=gobgp_reader
# = contenu de lorion03vel/gobgp-neo4j-sync/secrets/ch_gobgp_reader_password
# (utilisateur créé via lorion01vel/gobgp/schemas/01_reader_role.sql)
# CLICKHOUSE_PASSWORD -> mettre la valeur dans secrets/ch_gobgp_reader_password (chmod 600, printf sans guillemets)

# ── Neo4j ───────────────────────────────────────────────────
NEO4J_URI=bolt://lorion03vel-neo4j:7687
NEO4J_USER=neo4j
# = contenu de lorion03vel/neo4j/secrets/neo4j_auth (après le "/")
# NEO4J_PASSWORD -> secrets/neo4j_password (chmod 600)

# ── Reconciler ──────────────────────────────────────────────
# Intervalle entre deux cycles de synchro complète (tables d'état), secondes.
RECONCILE_INTERVAL_SECONDS=300
# Intervalle entre deux cycles de lecture des tables monitor_bgp_*, secondes.
MONITOR_POLL_INTERVAL_SECONDS=20
# Fenêtre glissante (Age > now() - fenêtre) lue à chaque cycle monitor : doit
# être > MONITOR_POLL_INTERVAL_SECONDS pour couvrir un éventuel cycle en retard.
MONITOR_WINDOW_SECONDS=120

# ── Divers ──────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Build uniquement (proxy pour pip pendant docker build) ──
#BUILD_HTTP_PROXY=http://<https_proxy_addr>:<port>
#BUILD_HTTPS_PROXY=http://<https_proxy_addr>:<port>

# ── Image buildée ───────────────────────────────────────────
# Tag de l'image locale (orion/<service>:<tag>). Bump à chaque évolution :
# l'ancienne image reste disponible pour un rollback.
#IMAGE_TAG=0.1.0
